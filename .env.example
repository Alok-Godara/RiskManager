# Copy this file to .env (or .env.local) and fill in your values.
# Both are gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# QuantHub market data (live prices)
# ---------------------------------------------------------------------------
# NOT prefixed with VITE_ on purpose: Vite only exposes VITE_* vars to browser
# code, so keeping this unprefixed guarantees the token never lands in the
# JS bundle. Locally, the dev/preview server reads it (vite.config.ts) and
# injects "Authorization: Bearer <token>" into requests it proxies to
# QuantHub, which also avoids CORS. Restart `npm run dev` after changing it.
#
# DEPLOYED (Netlify): there is no dev server in production, so this .env
# file is irrelevant there — set QH_API_TOKEN as a site environment
# variable instead (Netlify dashboard -> Site configuration -> Environment
# variables), which netlify/edge-functions/qh-api-proxy.ts reads at request
# time. Forgetting this step is the "QuantHub returned a response that
# isn't valid JSON" failure mode: without the Edge Function's token, /qh-api
# requests fall through to the SPA catch-all and get index.html back.
#
# With this unset (locally) or the Edge Function unconfigured (deployed),
# the app falls back to simulated prices.
QH_API_TOKEN=

# Optional — defaults to https://qh-api.corp.hertshtengroup.com. Set the
# same way as QH_API_TOKEN above (local .env vs. Netlify site env var).
QH_API_URL=

# Optional — same-origin base path the client calls. Defaults to "/qh-api",
# which both the local Vite proxy and the deployed Netlify Edge Function
# already serve — leave unset unless you're using a different proxy setup.
VITE_QH_API_BASE=

# ---------------------------------------------------------------------------
# Supabase (cloud persistence)
# ---------------------------------------------------------------------------
# If left unset, the app runs entirely locally against IndexedDB — no
# Supabase account required. See supabase/schema.sql for the table setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
