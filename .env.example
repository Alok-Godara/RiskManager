# Copy this file to .env (or .env.local) and fill in your values.
# Both are gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# QuantHub market data (live prices)
# ---------------------------------------------------------------------------
# NOT prefixed with VITE_ on purpose: Vite only exposes VITE_* vars to browser
# code, so keeping this unprefixed guarantees the token never lands in the
# JS bundle. The dev/preview server reads it (vite.config.ts) and injects
# "Authorization: Bearer <token>" into requests it proxies to QuantHub, which
# also avoids CORS. Restart `npm run dev` after changing it.
#
# With this unset the app falls back to simulated prices.
QH_API_TOKEN=

# Optional — defaults to https://qh-api.corp.hertshtengroup.com
QH_API_URL=

# Optional — same-origin base path the client calls (default "/qh-api").
# Point this at an equivalent server-side proxy when deploying.
VITE_QH_API_BASE=

# ---------------------------------------------------------------------------
# Supabase (cloud persistence)
# ---------------------------------------------------------------------------
# If left unset, the app runs entirely locally against IndexedDB — no
# Supabase account required. See supabase/schema.sql for the table setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
