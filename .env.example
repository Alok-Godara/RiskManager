# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# If left unset, the app runs entirely locally against IndexedDB — no
# Supabase account required. See supabase/schema.sql for the table setup.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
